'******************************************************************************
'***    EXEMPLE:  PAVTactileNumFormInitialise()                             ***
'******************************************************************************
Private Sub PAVTactileNumFormInitialise()
End Sub

'******************************************************************************
'***    PROCEDURE:PAVTactileNumFormPosition()                               ***
'******************************************************************************
'***    FONCTION: Positionner la feuille sur l'ecran                        ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  PAVTactileNumFormPosition()                               ***
'******************************************************************************
Private Sub PAVTactileNumFormPosition()
    ' Je positionne la feuille a l'ecran
    ControlInitialise PAVTactileNumForm, 0, Screen.Height * 11 / 15, Screen.Width * 6 / 21, Screen.Height * 4 / 15
    ' Fin
End Sub

'******************************************************************************
'***    PROCEDURE:PAVTactileNumCDButtonInitialise()                         ***
'******************************************************************************
'***    FONCTION: Initialiser - Le texte des boutons                        ***
'***                          - Les images des boutons                      ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  PAVTactileNumCDButtonInitialise()                         ***
'******************************************************************************
Private Sub PAVTactileNumCDButtonInitialise()
    Dim I As Integer                                                            ' Le numero du bouton courant
    ' Je fait defiler tous les bouton
    For I = 0 To PAVTactileNumCDButton.Count - 1
        ' Je charge l'image du bouton
        PAVTactileNumCDButton(I).Picture = RessourceIconLoad(1100 + I)
        ' Je charge le texte du bouton
        PAVTactileNumCDButton(I).Caption = RessourceStringLoad(1100 + I)
    ' Je ne sort que si j'ai fini de faire defiler les boutons
    Next I
    ' Fin
End Sub

'******************************************************************************
'***    PROCEDURE:PAVTactileNumCDButtonPosition()                           ***
'******************************************************************************
'***    FONCTION: Repositionner les boutons sur la form                     ***
'***              redimensionner la taille des fontes                       ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  PAVTactileNumCDButtonPosition()                           ***
'******************************************************************************
Private Sub PAVTactileNumCDButtonPosition()
    Dim I As Integer                                                            ' Le numero du bouton courant
    Dim CDButtonLef As Single                                                   ' La position gauche du bouton courant
    Dim CDButtonTop As Single                                                   ' La hauteur du bouton courant
    Dim CDButtonLgr As Single                                                   ' La longueur du bouton courant
    Dim CDButtonLar As Single                                                   ' La largueur du bouton courant
    ' Je fait defiler tous les boutons
    For I = 0 To PAVTactileNumCDButton.Count - 1
        ' Je calcule la position gauche du boutons
        CDButtonLef = (I Mod 4) * PAVTactileNumForm.ScaleWidth / 4
        ' Je calcule la hauteur du boutons
        CDButtonTop = Int(I / 4) * PAVTactileNumForm.ScaleHeight / 4
        ' Je calcule la longueur du boutons
        CDButtonLgr = PAVTactileNumForm.ScaleWidth / 4
        ' Je calcule la largueur du boutons
        CDButtonLar = PAVTactileNumForm.ScaleHeight / 4
        ' Je repositionne le bouton et ajuste la taille des fontes
        ControlInitialise PAVTactileNumCDButton(I), CDButtonLef, CDButtonTop, CDButtonLgr, CDButtonLar
    ' Je ne sort que si j'ai fini de faire defiler les boutons
    Next I
    ' Fin
End Sub

'******************************************************************************
'***    Evenement internes                                                  ***
'******************************************************************************

'******************************************************************************
'***    EVENEMENT:  Form_Load()                                             ***
'******************************************************************************
'***    FONCTION:   Initialiser les variables des forms et des controles    ***
'***                Positionner la feuille sur l'ecran                      ***
'******************************************************************************
'***    ENTREE:     Néant                                                   ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub Form_Load()
    ' J'initialise la form
    PAVTactileNumFormInitialise
    ' J'initialise les boutons
    PAVTactileNumCDButtonInitialise
    ' Je positionne la form a l'ecran
    PAVTactileNumFormPosition
    ' Fin
End Sub

'******************************************************************************
'***    EVENEMENT:  Form_Resize()                                           ***
'******************************************************************************
'***    FONCTION:   repositionner les controles sur la form                 ***
'***                                                                        ***
'******************************************************************************
'***    ENTREE:     Néant                                                   ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub Form_Resize()
    ' Je repositionne les boutons
    PAVTactileNumCDButtonPosition
    ' Fin
End Sub

'******************************************************************************
'***    EVENEMENT:  PAVTactileNumCDButton_Click(Index As Integer)           ***
'******************************************************************************
'***    FONCTION:   l'user a appuyer un bouton du clavier numerique         ***
'***                                                                        ***
'******************************************************************************
'***    ENTREE:     index - Numero du bouton appuyer                        ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub PAVTactileNumCDButton_Click(Index As Integer)
    ' Je renvoie le caractere a la zone de saisie
    ToucheValidation (PAVTactileNumCDButton(Index).Caption)
    ' Fin
End Sub
