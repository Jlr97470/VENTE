'******************************************************************************

'******************************************************************************
'***    PROCEDURE:FormPavTactileAlphaInitialise()                           ***
'******************************************************************************
'***    FONCTION: Initialiser                                               ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  FormPavTactileAlphaInitialise                             ***
'******************************************************************************
Private Sub FormPavTactileAlphaInitialise()
End Sub

'******************************************************************************
'***    PROCEDURE:PAVTactileAlphaCDButtonInitialise()                       ***
'******************************************************************************
'***    FONCTION: Initialiser - Le texte des boutons                        ***
'***                          - Les images des boutons                      ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  PAVTactileAlphaCDButtonInitialise                         ***
'******************************************************************************
Private Sub PAVTactileAlphaCDButtonInitialise()
    Dim I As Integer                                                            ' Le numero du bouton courant
    ' Je fait defiler tous les bouton
    For I = 0 To PAVTactileAlphaCDButton.Count - 1
        ' Je charge l'image du bouton
        PAVTactileAlphaCDButton(I).Picture = RessourceIconLoad(1000 + I)
        ' Je charge le texte du bouton
        PAVTactileAlphaCDButton(I).Caption = RessourceStringLoad(1000 + I)
    ' Je ne sort que si j'ai fini de faire defiler les boutons
    Next I
    ' Fin
End Sub

'******************************************************************************
'***    PROCEDURE:FormPavTactileAlphaPosition()                             ***
'******************************************************************************
'***    FONCTION: Positionner la form a l'ecran                             ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  FormPavTactileAlphaPosition                               ***
'******************************************************************************
Private Sub FormPavTactileAlphaPosition()
    ' Je positionne la feuille a l'ecran
    ControlInitialise FormPavTactileAlpha, Screen.Width * 6 / 21, Screen.Height * 12 / 15, Screen.Width * 15 / 21, Screen.Height * 3 / 15
    ' Fin
End Sub

'******************************************************************************
'***    PROCEDURE:PAVTactileAlphaCDButtonPosition()                         ***
'******************************************************************************
'***    FONCTION: Repositionner les boutons sur la form                     ***
'***              Redimensionner la taille des fontes                       ***
'******************************************************************************
'***    ENTREE:   Néant                                                     ***
'***                                                                        ***
'***    SORTIE:   Néant                                                     ***
'******************************************************************************
'***    EXEMPLE:  PAVTactileAlphaCDButtonPosition                           ***
'******************************************************************************
Private Sub PAVTactileAlphaCDButtonPosition()
    Dim I As Integer                                                            ' Le numero du bouton courant
    Dim CDButtonLef As Single                                                   ' La position gauche du bouton courant
    Dim CDButtonTop As Single                                                   ' La hauteur du bouton courant
    Dim CDButtonLgr As Single                                                   ' La longueur du bouton courant
    Dim CDButtonLar As Single                                                   ' La largueur du bouton courant
    ' Je fait defiler tous les boutons
    For I = 0 To PAVTactileAlphaCDButton.Count - 1
        ' Je calcule la position gauche du boutons
        CDButtonLef = (I Mod 10) * FormPavTactileAlpha.ScaleWidth / 10
        ' Je calcule la hauteur du boutons
        CDButtonTop = Int(I / 10) * FormPavTactileAlpha.ScaleHeight / 3
        ' Je calcule la longueur du boutons
        CDButtonLgr = FormPavTactileAlpha.ScaleWidth / 10
        ' Je calcule la largueur du boutons
        CDButtonLar = FormPavTactileAlpha.ScaleHeight / 3
        ' Je repositionne le bouton et ajuste la taille des fontes
        ControlInitialise PAVTactileAlphaCDButton(I), CDButtonLef, CDButtonTop, CDButtonLgr, CDButtonLar
    ' Je ne sort que si j'ai fini de faire defiler les boutons
    Next I
    ' Fin
End Sub

'******************************************************************************
'***    Evenement internes                                                  ***
'******************************************************************************

'******************************************************************************
'***    EVENEMENT:  Form_Load()                                             ***
'******************************************************************************
'***    FONCTION:   Initialiser les variables des forms et des controles    ***
'***                Positionner la feuille sur l'ecran                      ***
'******************************************************************************
'***    ENTREE:     Néant                                                   ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub Form_Load()
    ' J'initialise la form
    FormPavTactileAlphaInitialise
    ' J'initialise les boutons
    PAVTactileAlphaCDButtonInitialise
    ' Je positionne la form a l'ecran
    FormPavTactileAlphaPosition
    ' Fin
End Sub

'******************************************************************************
'***    EVENEMENT:  Form_Resize()                                           ***
'******************************************************************************
'***    FONCTION:   repositionner les controles sur la form                 ***
'***                                                                        ***
'******************************************************************************
'***    ENTREE:     Néant                                                   ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub Form_Resize()
    ' Je repositionne les boutons
    PAVTactileAlphaCDButtonPosition
    ' Fin
End Sub

'******************************************************************************
'***    EVENEMENT:  PAVTactileAlphaCDButton_Click(Index As Integer)         ***
'******************************************************************************
'***    FONCTION:   L'user a appuyer un bouton du clavier alpha             ***
'***                                                                        ***
'******************************************************************************
'***    ENTREE:     Index - Numero du bouton appuyer                        ***
'***                                                                        ***
'***    SORTIE:     Néant                                                   ***
'******************************************************************************
Private Sub PAVTactileAlphaCDButton_Click(Index As Integer)
    ' Je renvoie le caractere a la zone de saisie
    ToucheValidation (PAVTactileAlphaCDButton(Index).Caption)
    ' Fin
End Sub
